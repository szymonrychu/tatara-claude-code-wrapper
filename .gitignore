bin/
dist/
*.log
.worktrees/
# Binaries built straight into the repo root (`go build -o wrapper ./cmd/wrapper`)
# instead of into bin/. One of these was committed onto an agent task branch and
# inherited by every later turn (issue #131).
/wrapper
/cc-stop-hook

# pytest/python bytecode. Never useful in a commit, and an agent task branch
# inherits everything it carries (see the built-binary incident, #131).
__pycache__/
*.pyc
